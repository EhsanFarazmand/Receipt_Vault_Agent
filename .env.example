# =============================================================================
# Receipt Vault — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored: NO real keys ever committed.
#   (competition hard rule: "DO NOT INCLUDE ANY API KEYS OR PASSWORDS IN YOUR CODE")
# =============================================================================

# ---- Model backend: Google AI Studio (local-first default) -----------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here
# Keep FALSE for the local-first / AI-Studio path. Set TRUE only for Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Vertex AI path (only if GOOGLE_GENAI_USE_VERTEXAI=TRUE; e.g. Cloud Run) -
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Model selection -------------------------------------------------------
# Overrides the default in app/config.py. Leave unset to use the project default.
# RECEIPT_VAULT_MODEL=gemini-flash-latest

# ---- Local vault paths (local-first; these dirs are git-ignored) -----------
RECEIPT_VAULT_INBOX=./inbox               # watched folder: drop receipts here
RECEIPT_VAULT_HOME=./vault                # renamed/filed source documents land here
RECEIPT_VAULT_DB=./vault/ledger.sqlite    # local SQLite ledger

# ---- Watchdog decision thresholds (see app/config.py) ----------------------
RECEIPT_VAULT_RETURN_THRESHOLD_DAYS=7     # fire when a return window has <= N days left
RECEIPT_VAULT_WARRANTY_THRESHOLD_DAYS=30  # fire when a warranty expires within N days

# ---- Outbound (consumed external MCPs) — OPTIONAL, approval-gated -----------
# These are only needed if you wire the Action agent to real Gmail/Calendar MCPs.
# The agent NEVER sends without an explicit human "Vibe Diff" approval.
# GMAIL_MCP_TOKEN=
# GOOGLE_CALENDAR_MCP_TOKEN=
