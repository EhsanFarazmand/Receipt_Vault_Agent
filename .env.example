# Receipt Vault — environment template.
# Copy to `.env` and fill in.  NEVER commit the real `.env` (it is git-ignored).
# HARD RULE (competition + project): no API keys or secrets in code or the repo.

# --- Model access: choose ONE path ---------------------------------------
# Path 1 — Google AI Studio API key (simplest for local prototyping).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Path 2 — Vertex AI (used on Cloud Run; auth via ADC, no key in code).
#   Leave GOOGLE_API_KEY unset and instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global        # 'global' avoids model 404s (see CLAUDE.md)

# --- Model (kept aligned with the scaffold; do not change casually) -------
RECEIPT_VAULT_MODEL=gemini-flash-latest

# --- Local-first working directories (stay on the user's machine) ---------
# On Cloud Run the container FS is read-only except /tmp — point these at /tmp.
RECEIPT_VAULT_INBOX=./inbox
RECEIPT_VAULT_STORE=./vault
RECEIPT_VAULT_DB=./data/receipt_vault.db
RECEIPT_VAULT_AUDIT=./audit/audit.log

# --- Decision thresholds (rule CR3) ---------------------------------------
RECEIPT_VAULT_RETURN_ALERT_DAYS=7
RECEIPT_VAULT_WARRANTY_ALERT_DAYS=30

# --- Reproducible demo/eval: pin "today" so window math is deterministic ---
# Leave unset in normal use (defaults to the real date).
# RECEIPT_VAULT_TODAY=2026-07-02
