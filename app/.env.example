# =============================================================================
# Receipt Vault — the env file ADK/agents-cli auto-loads (the AGENT directory's .env).
# Copy this to `app/.env` and fill in. `app/.env` is git-ignored: NO real keys committed.
#   (competition hard rule: "DO NOT INCLUDE ANY API KEYS OR PASSWORDS IN YOUR CODE")
#
#   copy app\.env.example app\.env      # Windows
#   cp   app/.env.example app/.env      # macOS/Linux
# =============================================================================

# ---- Model backend: Google AI Studio (local-first default) -----------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_API_KEY
# Keep FALSE for the local-first / AI-Studio path. Set TRUE only for Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ---- Vertex AI path (only if GOOGLE_GENAI_USE_VERTEXAI=TRUE; e.g. Cloud Run) -
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Model selection (optional; overrides app/config.py default) -----------
# RECEIPT_VAULT_MODEL=gemini-flash-latest

# ---- Local vault paths (optional overrides; all default under the repo) -----
# RECEIPT_VAULT_INBOX=./inbox
# RECEIPT_VAULT_HOME=./vault
# RECEIPT_VAULT_DB=./vault/ledger.sqlite

# ---- Watchdog decision thresholds (optional; see app/config.py) -------------
# RECEIPT_VAULT_RETURN_THRESHOLD_DAYS=7
# RECEIPT_VAULT_WARRANTY_THRESHOLD_DAYS=30
